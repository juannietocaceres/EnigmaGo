# URL del proyecto de Supabase. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: Supabase → Project Settings → API → Project URL.
VITE_SUPABASE_URL=

# Clave pública (anon / publishable) de Supabase. Ámbito: cliente. Sensible: no.
# Dónde se obtiene: Supabase → Project Settings → API Keys → anon public (o publishable).
# NUNCA poner aquí la service_role / secret key.
VITE_SUPABASE_ANON_KEY=
